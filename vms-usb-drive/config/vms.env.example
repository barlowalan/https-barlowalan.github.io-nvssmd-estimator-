# USB VMS Drive — site configuration
# Copy to vms.env and edit before install (or let install.sh generate defaults).

VMS_SITE_NAME="Site"
VMS_TZ="America/New_York"
VMS_MAX_CAMERAS=24
VMS_DATA_DIR="/opt/vms/data"
VMS_CONFIG_DIR="/opt/vms/config"
VMS_HTTP_PORT=5000
VMS_RTSP_PORT=8554
VMS_WEBRTC_PORT=8555

# Default ONVIF / RTSP credentials used during discovery (override per camera later)
CAMERA_USER="admin"
CAMERA_PASSWORD="admin"

# Recording retention (days) — Frigate retain policy
RECORD_RETAIN_DAYS=14
DETECTION_ENABLED=false
