# NVSSMD VMS — camera inventory (max 24)
# Generated by scripts/detect-cameras.sh or edited by hand.
# Each entry is merged into Frigate config at install / refresh time.

max_cameras: 24

cameras: []
# Example:
# cameras:
#   - id: cam01
#     name: Front Entrance
#     host: 192.168.1.101
#     manufacturer: Hikvision
#     model: DS-2CD2143
#     onvif_url: http://192.168.1.101:80/onvif/device_service
#     rtsp_main: rtsp://admin:password@192.168.1.101:554/Streaming/Channels/101
#     rtsp_sub: rtsp://admin:password@192.168.1.101:554/Streaming/Channels/102
#     enabled: true
