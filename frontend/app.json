{
  "expo": {
    "name": "SEP Explorer",
    "slug": "sep-explorer",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "sepexplorer",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "primaryColor": "#0A1B3A",
    "description": "SEP Explorer — free on-site security estimating for contractors. Capture projects, catalog, and labor on iPad and Android.",
    "githubUrl": "https://github.com/barlowalan/https-barlowalan.github.io-nvssmd-estimator-",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nvssmd.sepexplorer",
      "buildNumber": "1",
      "requireFullScreen": false,
      "infoPlist": {
        "CFBundleDisplayName": "SEP Explorer",
        "CFBundleName": "SEP Explorer",
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "SEP Explorer imports equipment price books from files you select.",
        "NSDocumentPickerUsageDescription": "SEP Explorer imports CSV equipment catalogs you choose.",
        "UISupportedInterfaceOrientations": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ],
        "UISupportedInterfaceOrientations~ipad": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationPortraitUpsideDown",
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ]
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": ["C617.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": ["E174.1"]
          }
        ],
        "NSPrivacyCollectedDataTypes": [],
        "NSPrivacyTracking": false
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.nvssmd.sepexplorer",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0A1B3A"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ],
      "playStoreUrl": "https://play.google.com/store/apps/details?id=com.nvssmd.sepexplorer"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#0A1B3A"
        }
      ],
      [
        "expo-document-picker",
        {
          "iCloudContainerEnvironment": "Production"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "REPLACE_WITH_EAS_PROJECT_ID"
      },
      "store": {
        "privacyPolicyUrl": "https://nvssmd.com/sep-explorer/privacy",
        "supportUrl": "https://nvssmd.com/sep-explorer/support",
        "termsUrl": "https://nvssmd.com/sep-explorer/terms",
        "marketingUrl": "https://nvssmd.com"
      }
    },
    "owner": "nvssmd",
    "experiments": {
      "typedRoutes": true
    }
  }
}
